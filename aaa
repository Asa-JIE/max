    def set_status(self):
        """刷新状态栏：统计当前已经设置的 FBX/Bip 数量。"""
        count_fbx = 0
        count_bip = 0
        for pair in self.pairs:
            if pair.fbx_obj is not None:
                count_fbx += 1
            if pair.bip_obj is not None:
                count_bip += 1
        if self.root_obj_fbx is not None:
            count_fbx += 1
        if self.root_obj_bip is not None:
            count_bip += 1
        if self.label_status:
            self.label_status.setText("Status : %s FBX, %s Bip" % (count_fbx, count_bip))

    def set_bip_info(self):
        """显示当前列表行对应的 Biped 类型信息。"""
        if not self.label_bip_info or not self.list_widget:
            return
        row = self.list_widget.currentRow()
        if row < 0 or row >= len(self.pairs):
            self.label_bip_info.setText("Biped : ")
            return
        bip_type = self.get_biped_type(self.pairs[row].bip_obj)
        if bip_type is None:
            self.label_bip_info.setText("Biped : ")
        else:
            self.label_bip_info.setText("Biped : %s, Link = %s" % (bip_type.limb_name, bip_type.link_index))

    def set_list(self):
        """刷新映射列表 UI。"""
        if not self.list_widget:
            return
        current = self.list_widget.currentRow()
        self.list_widget.clear()
        for pair in self.pairs:
            fbx_name = pair.fbx_obj.name if pair.fbx_obj is not None else "( ... )"
            bip_name = pair.bip_obj.name if pair.bip_obj is not None else "( ... )"
            #self.list_widget.addItem("%s --> %s" % (fbx_name, bip_name))
            # ui
            text = "{:<28}  -->  {}".format(fbx_name, bip_name)
            item = QtWidgets.QListWidgetItem(text)
            item.setToolTip(text)
            self.list_widget.addItem(item)
            # ui
        if self.pairs:
            self.list_widget.setCurrentRow(min(max(current, 0), len(self.pairs) - 1))
        if self.label_fbx_root:
            self.label_fbx_root.setText(self.root_obj_fbx.name if self.root_obj_fbx else "")
        if self.label_bip_root:
            self.label_bip_root.setText(self.root_obj_bip.name if self.root_obj_bip else "")
        self.set_status()
        self.set_bip_info()

    # ============================================================
    # 映射管理按钮
    # ============================================================

    def select_objects(self, objs):
        """安全选择一组 Max 节点。"""
        objs = [o for o in objs if o is not None]
        if not objs:
            return
        try:
            rt.select(objs)
        except Exception:
            try:
                rt.clearSelection()
                for o in objs:
                    rt.selectMore(o)
            except Exception:
                pass

    def get_current_index(self):
        row = self.list_widget.currentRow() if self.list_widget else -1
        if row < 0 or row >= len(self.pairs):
            return -1
        return row

    def auto_hide_obj(self, obj):
        if self.check_auto_hide and self.check_auto_hide.isChecked() and obj is not None:
            try:
                rt.hide(obj)
            except Exception:
                try:
                    obj.isHidden = True
                except Exception:
                    pass
            rt.clearSelection()
            return True
        return False

    def scan_root(self):
        """扫描场景 userProp，找回之前保存过的 FBX Root / Bip Root。"""
        for o in rt.objects:
            try:
                if rt.getUserProp(o, "SoxFbxToBiped_FbxRoot") is True:
                    self.root_obj_fbx = o
                if rt.getUserProp(o, "SoxFbxToBiped_BipRoot") is True:
                    self.root_obj_bip = o
            except Exception:
                pass
        self.set_list()

    def set_root_fbx_from_selection(self):
        obj = self.get_selected_one()
        if obj is None:
            return
        if self.is_biped_object(obj):
            rt.messageBox("Please select NON Biped Object")
            return
        if self.root_obj_fbx == obj:
            return
        self.root_obj_fbx = obj
        for pair in self.pairs:
            pair.fbx_obj = None
        self.set_user_prop_fbx_root(obj)
        self.auto_hide_obj(obj)
        self.set_list()

    def set_root_bip_from_selection(self):
        obj = self.get_selected_one()
        if obj is None:
            return
        non_biped_mode = self.check_non_biped.isChecked() if self.check_non_biped else False
        if (not self.is_biped_object(obj)) and (not non_biped_mode):
            rt.messageBox("Please select Biped Object")
            return
        if self.root_obj_bip == obj:
            return
        self.root_obj_bip = obj
        for pair in self.pairs:
            pair.bip_obj = None
        self.set_user_prop_bip_root(obj)
        self.auto_hide_obj(obj)
        self.set_list()

    def list_add(self):
        """新增一行空映射，并选中新行。"""
        self.pairs.append(PairDef())
        self.set_list()
        if self.list_widget:
            self.list_widget.setCurrentRow(len(self.pairs) - 1)

    def list_del(self):
        """删除当前映射行。"""
        row = self.get_current_index()
        if row >= 0:
            self.pairs.pop(row)
        self.set_list()

    def current_pair(self):
        row = self.get_current_index()
        if row < 0:
            return None
        return self.pairs[row]

    def set_fbx_from_selection(self):
        row = self.get_current_index()
        if row < 0:
            return
        obj = self.get_selected_one()
        if obj is None:
            return
        if self.is_biped_object(obj):
            rt.messageBox("Please select NON Biped Object")
            return
        old_pos = self.find_in_pairs_fbx(obj)
        if old_pos >= 0:
