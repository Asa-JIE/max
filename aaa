    def figure_sync(self):
        """Figure Sync：按原 MaxScript 逻辑迁移版。"""

        self.sort_by_hierarchy()
        self.set_list()

        if self.non_biped_check():
            rt.messageBox("当前列表包含非 Biped 对象，Figure Sync 已跳过")
            return

        if not self.check_match():
            rt.messageBox("Please check list")
            return

        if not self.pairs or self.root_obj_fbx is None or self.root_obj_bip is None:
            return

        def get_pair_fbx_by_bip(bip_obj):
            idx = self.find_in_pairs_bip(bip_obj)
            if idx >= 0:
                return self.pairs[idx].fbx_obj
            return None

        def get_pair_bip_by_fbx(fbx_obj):
            idx = self.find_in_pairs_fbx(fbx_obj)
            if idx >= 0:
                return self.pairs[idx].bip_obj
            return None

        def get_fbx_parent_from_bip_parent(me_fbx, me_bip):
            """
            对应原 MaxScript:
            if meBip.parent == rootObjBip then tMeFbxParent = rootObjFbx
            else tMeFbxParent = pairs[FindInPairsBip(meBip.parent)].fbxObj
            """
            if me_bip.parent == self.root_obj_bip:
                return self.root_obj_fbx

            parent_index = self.find_in_pairs_bip(me_bip.parent)

            if parent_index >= 0:
                return self.pairs[parent_index].fbx_obj

            # 原脚本 default 分支里有这个兜底:
            # 找不到 Biped parent，就用当前 FBX 的 parent
            if me_fbx is not None:
                return me_fbx.parent

            return None

        def get_bip_parent_from_fbx_parent(t_fbx_parent, me_bip):
            """
            对应原 MaxScript:
            if tMeFbxParent == rootObjFbx then tBipParent = rootObjBip
            else tBipParent = pairs[FindInPairsFbx(tMeFbxParent)].bipObj
            """
            if t_fbx_parent == self.root_obj_fbx:
                return self.root_obj_bip

            fbx_parent_index = self.find_in_pairs_fbx(t_fbx_parent)
            if fbx_parent_index >= 0:
                return self.pairs[fbx_parent_index].bip_obj

            # 原脚本针对 Xtra / parent 缺失时的兜底
            return me_bip.parent

        def set_position_by_parent_delta(me_fbx, me_bip):
            """
            原版核心位置算法:
            tDeltaPosFbx = meFbx.transform.position - tMeFbxParent.transform.position
            tBipPos = tBipParent.transform.position + tDeltaPosFbx
            """
            t_me_fbx_parent = get_fbx_parent_from_bip_parent(me_fbx, me_bip)

            if t_me_fbx_parent is None:
                target_pos = me_fbx.transform.position
                rt.biped.setTransform(me_bip, rt.Name("pos"), target_pos, False)
                return target_pos

            t_delta_pos_fbx = me_fbx.transform.position - t_me_fbx_parent.transform.position
            t_bip_parent = get_bip_parent_from_fbx_parent(t_me_fbx_parent, me_bip)

            if t_bip_parent is None:
                target_pos = me_fbx.transform.position
            else:
                target_pos = t_bip_parent.transform.position + t_delta_pos_fbx

            me_bip.transform = rt.matrix3(1)
            rt.biped.setTransform(me_bip, rt.Name("pos"), target_pos, False)
            return target_pos

        def set_scale_by_child_distance(me_fbx, me_bip, child_for_scale, original_scale):
            """
            原版 default / clavicle 分支:
            tDist = distance meFbx.transform.position tChildFbx.transform.position
            biped.setTransform meBip #scale [tDist, oldScale.y, oldScale.z] false
            """
            child_index = self.find_in_pairs_bip(child_for_scale)
            if child_index < 0:
                return

            child_fbx = self.pairs[child_index].fbx_obj
            if child_fbx is None:
                return

            dist = rt.distance(me_fbx.transform.position, child_fbx.transform.position)
            rt.biped.setTransform(
                me_bip,
                rt.Name("scale"),
                rt.Point3(dist, original_scale.y, original_scale.z),
                False
            )

        try:
            rt.setCommandPanelTaskMode(mode=rt.Name("motion"))
            rt.select(self.root_obj_bip)

            # 保存原 Figure Mode 状态
            try:
                figure_saved = self.root_obj_bip.controller.rootnode.controller.figureMode
            except Exception:
                figure_saved = False

            self.root_obj_bip.controller.rootnode.controller.figureMode = True

            # Root 对齐
            rt.biped.setTransform(
                self.root_obj_bip,
                rt.Name("pos"),
                self.root_obj_fbx.transform.position,
                False
            )
            rt.biped.setTransform(
                self.root_obj_bip,
                rt.Name("rotation"),
                self.root_obj_fbx.transform.rotation,
                False
            )

            for pair in self.pairs:
                me_fbx = pair.fbx_obj
                me_bip = pair.bip_obj

                if me_fbx is None or me_bip is None:
                    continue

                bip_type = self.get_biped_type(me_bip)
                if bip_type is None:
                    continue

                limb_name = str(bip_type.limb_name)
                link_index = bip_type.link_index

                child_for_scale = self.get_child_by_scale_pos(me_bip)
                original_scale = rt.biped.getTransform(me_bip, rt.Name("scale"))

                # ------------------------------------------------------------
                # Pelvis
                # ------------------------------------------------------------
                if limb_name == "pelvis":
                    try:
                        l_leg = rt.biped.getNode(self.root_obj_bip, rt.Name("lleg"), link=1)
                        r_leg = rt.biped.getNode(self.root_obj_bip, rt.Name("rleg"), link=1)
                    except Exception:
                        l_leg = None
                        r_leg = None

                    l_leg_fbx = get_pair_fbx_by_bip(l_leg)
                    r_leg_fbx = get_pair_fbx_by_bip(r_leg)

                    if l_leg_fbx is not None and r_leg_fbx is not None:
                        dist = rt.distance(
                            l_leg_fbx.transform.position,
                            r_leg_fbx.transform.position
                        )
                        
                        me_bip.transform = rt.matrix3(1)
                        rt.biped.setTransform(
                            me_bip,
                            rt.Name("rotation"),

                            me_fbx.transform.rotation,

                            False
                        )
                        
                        #[Asa]<

                        #[Asa]>
                        rt.biped.setTransform(
                            me_bip,
                            rt.Name("scale"),
                            rt.Point3(original_scale.x, original_scale.y, dist),
                            False
                        )

                    continue

                # ------------------------------------------------------------
                # Left / Right Foot
                # 原脚本: lleg/rleg link 3
                # ------------------------------------------------------------
                if limb_name in ("lleg", "rleg") and link_index == 3:
                    
                    set_position_by_parent_delta(me_fbx, me_bip)

                    offset_quat = self.get_biped_foot_angle_quat(me_bip)
                    final_quat = offset_quat * me_fbx.transform.rotation

                    rt.biped.setTransform(
                        me_bip,
                        rt.Name("rotation"),
                        final_quat,
                        False
                    )
                

                    child_index = self.find_in_pairs_bip(child_for_scale)
                    if child_index >= 0:
                        rt.biped.setTransform(
                            me_bip,
                            rt.Name("scale"),
                            rt.Point3(
                                self.spin_foot_height.value() if self.spin_foot_height else 10,
                                original_scale.y,
                                original_scale.z
                            ),
                            False
                        )

                    continue
                # [asa]《------------------------------------------------------------
                # Left / Right Thigh + Calf
                # lleg/rleg : link 1 = thigh
                #              link 2 = calf
                # ------------------------------------------------------------
                if limb_name in ("lleg", "rleg") and link_index in (1, 2):

                    set_position_by_parent_delta(me_fbx, me_bip)

                    axis_offset = rt.eulerAngles(0, 0, 90).rotation

                    final_rot = me_fbx.transform.rotation * axis_offset

                    rt.biped.setTransform(
                        me_bip,
                        rt.Name("rotation"),
                        final_rot,
                        False
                    )

                    set_scale_by_child_distance(
                        me_fbx,
                        me_bip,
                        child_for_scale,
                        original_scale
                    )

                    continue
                #[asa]>
                # ------------------------------------------------------------
                # L / R Clavicle
                # 原脚本: larm/rarm link 1
                # ------------------------------------------------------------
                if limb_name in ("larm", "rarm") and link_index == 1:
                    set_position_by_parent_delta(me_fbx, me_bip)

                    # 原 MaxScript 特殊处理:
                    # figureMode = false -> set rotation -> copyPosture -> figureMode = true -> pastePosture
                    try:
                        self.root_obj_bip.controller.figureMode = False
                    except Exception:
                        try:
                            self.root_obj_bip.controller.rootnode.controller.figureMode = False
                        except Exception:
                            pass
                    
                    rt.biped.setTransform(
                        me_bip,
                        rt.Name("rotation"),
                        me_fbx.transform.rotation,
                        False
                    )
                    
                    #[Asa]<

                    #[Asa]>
                    try:
                        now_ctrl = me_bip.controller

                        if rt.biped.numCopyCollections(now_ctrl) == 0:
                            rt.biped.createCopyCollection(now_ctrl, "Col01")

                        rt.select(me_bip)
                        posture_name = rt.biped.copyPosture(
                            now_ctrl,
                            rt.Name("posture"),
                            True,
                            True,
                            True
                        )

                        try:
                            self.root_obj_bip.controller.figureMode = True
                        except Exception:
                            self.root_obj_bip.controller.rootnode.controller.figureMode = True

                        rt.biped.pastePosture(
                            now_ctrl,
                            rt.Name("posture"),
                            False,
                            posture_name
                        )
                        rt.biped.deleteCopy(
                            now_ctrl,
                            rt.Name("posture"),
                            posture_name
                        )

                    except Exception as e:
                        print("[FigureSync][Clavicle posture failed]:", me_bip.name, e)
                        try:
                            self.root_obj_bip.controller.rootnode.controller.figureMode = True
                        except Exception:
                            pass

                    set_scale_by_child_distance(me_fbx, me_bip, child_for_scale, original_scale)
                    continue

                # ------------------------------------------------------------
                # Default
                # ------------------------------------------------------------
                set_position_by_parent_delta(me_fbx, me_bip)

                # 这里先按原逻辑恢复 rotation。
                # 如果你的 Dummy rotation 仍然导致翻轴，后面再单独加 offset table。
                rt.biped.setTransform(
                    me_bip,
                    rt.Name("rotation"),
                    me_fbx.transform.rotation,
                    False
                )

                set_scale_by_child_distance(me_fbx, me_bip, child_for_scale, original_scale)

            # 恢复 figure mode
            try:
                self.root_obj_bip.controller.rootnode.controller.figureMode = figure_saved
            except Exception:
                pass

        except Exception as e:
            import traceback
            traceback.print_exc()
            rt.messageBox("Figure Sync failed:\n%s" % e)#按照原来的逻辑修改


    def _get_key_frame_range(self):
        one_frame = self.radio_key_one_frame.isChecked() if self.radio_key_one_frame else False
        if one_frame:
            frame = int(rt.sliderTime)
            return frame, frame
        return int(rt.animationRange.start), int(rt.animationRange.end)

    def key_all(self):
        """Key All：按 Animation Range 或 1 Frame 烘焙所有映射。"""
        if not self.check_match():
            rt.messageBox("Please check list")
            return
        if not self.pairs or self.root_obj_bip is None or self.root_obj_fbx is None:
            return
        frame_start, frame_end = self._get_key_frame_range()
        sel_backup = self.get_selection()
        try:
            self.reset_biped_matrix()
            self.sync_key_ranged_all(frame_start, frame_end)
        finally:
            self.select_objects(sel_backup)

    def key_selected_one(self):
        """Key Selected One：只烘焙当前选择的 Biped/root。"""
        if not self.check_match():
            rt.messageBox("Please check list")
            return
        if not self.pairs or self.root_obj_bip is None or self.root_obj_fbx is None:
            return
        sel = self.get_selection()
        if not sel:
            return
        obj = sel[0]
        if self.find_in_pairs_bip(obj) < 0 and obj != self.root_obj_bip:
            return
        frame_start, frame_end = self._get_key_frame_range()
        sel_backup = list(sel)
        try:
            self.sync_key_ranged_sel(frame_start, frame_end, obj)
        finally:
            self.select_objects(sel_backup)

    def _get_non_root_biped_key_count(self, bip_obj):
        count = 1
        while True:
            try:
                rt.biped.getKey(bip_obj.transform.controller, count)
                count += 1
            except Exception:
                return count - 1

    def set_animation_range_by_selected_obj(self):
        """根据选择对象关键帧范围设置动画范围，对齐 MaxScript 中 Biped/root/普通对象分支。"""
        sel = self.get_selection()
        if not sel:
            return
        first = None
        last = None
        for obj in sel:
            temp_first = None
            temp_last = None
            try:
                if self.is_biped_object(obj):
                    try:
                        if obj == obj.transform.controller.rootNode:
                            keys = obj.transform.controller.horizontal.controller.keys
                            if keys.count != 0:
                                temp_first = keys[1].time
                                temp_last = keys[keys.count].time
                        else:
                            kc = self._get_non_root_biped_key_count(obj)
                            if kc != 0:
                                temp_first = rt.biped.getKey(obj.transform.controller, 1).time
                                temp_last = rt.biped.getKey(obj.transform.controller, kc).time
                    except Exception:
                        pass
                else:
                    try:
                        pos_keys = obj.position.controller.keys
                        rot_keys = obj.rotation.controller.keys
                        keys = pos_keys if pos_keys.count > rot_keys.count else rot_keys
                        if keys.count >= 1:
                            temp_first = keys[1].time
                            temp_last = keys[keys.count].time
                    except Exception:
                        pass
            except Exception:
                pass
            if temp_first is not None and temp_last is not None:
                first = temp_first if first is None else min(first, temp_first)
                last = temp_last if last is None else max(last, temp_last)
        if first is not None and last is not None:
            rt.animationRange = rt.interval(first, last)

    def replace_name_in_selection(self):
        """替换所选物体名称中的字符串。"""
        old = self.edit_replace_from.text() if self.edit_replace_from else ""
        new = self.edit_replace_to.text() if self.edit_replace_to else ""
        if not old:
            return
        for obj in self.get_selection():
            try:
                obj.name = obj.name.replace(old, new, 1)
            except Exception:
                pass
        self.set_list()

    def append_name(self):
        """Append!：选择 1 个则自身加后缀，选择 2 个则第二个改为第一个+后缀。"""
        sel = self.get_selection()
        if len(sel) >= 3:
            rt.messageBox("Please select only one or two objects.")
            return
        suffix = self.edit_append.text() if self.edit_append else ""
        if len(sel) == 1:
            sel[0].name = sel[0].name + suffix
        elif len(sel) == 2:
            sel[1].name = sel[0].name + suffix
        self.set_list()

    def append_align(self):
        """Apnnd Align!：第二个对齐第一个、parent 到第一个，并按第一个名称追加。"""
        sel = self.get_selection()
        if len(sel) != 2:
            rt.messageBox("You need to select two objects.")
            return
        suffix = self.edit_append.text() if self.edit_append else ""
        sel[1].transform = sel[0].transform
        sel[1].parent = sel[0]
        sel[1].name = sel[0].name + suffix
        self.set_list()

    def append_aligned_point(self):
        """Apnend Point!：给每个选择对象创建 point helper，颜色/大小/父子/变换一致。"""
        suffix = self.edit_append.text() if self.edit_append else ""
        size = self.spin_point_size.value() if self.spin_point_size else 10
        created = []
        for obj in self.get_selection():
            p = rt.Point()
            try:
                p.wirecolor = rt.color(14, 255, 2)
            except Exception:
                pass
            p.size = size
            p.parent = obj
            p.transform = obj.transform
            p.name = obj.name + suffix
            created.append(p)
        if created:
            self.select_objects(created)

    def add_position_constraint(self):
        """PositionConst.：对所有选中对象直接替换 Position_Constraint controller。"""
        for obj in self.get_selection():
            try:
                obj.pos.controller = rt.Position_Constraint()
            except Exception:
                try:
                    obj.position.controller = rt.Position_Constraint()
                except Exception:
                    pass

    def add_lookat_constraint(self):
        """LookAt.：对所有选中对象直接替换 LookAt_Constraint controller。"""
        for obj in self.get_selection():
            try:
                obj.rotation.controller = rt.LookAt_Constraint()
            except Exception:
                pass

    def add_orientation_constraint(self):
        """Orientation：对所有选中对象直接替换 Orientation_Constraint controller。"""
        for obj in self.get_selection():
            try:
                obj.rotation.controller = rt.Orientation_Constraint()
            except Exception:
                pass

