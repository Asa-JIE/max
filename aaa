    def get_children_safe(self, obj):
        """安全获取 Max 节点 children，避免 pymxs 下 obj.children 属性不可用或索引方式不一致。"""
        if obj is None:
            return []

        try:
            children = rt.getProperty(obj, "children")
            if children is None:
                return []

            count = int(children.count)
            result = []

            # pymxs 中多数集合按 0-based 访问。先走 0-based。
            try:
                for i in range(count):
                    result.append(children[i])
                return result
            except Exception:
                pass

            # 兜底：某些 MaxScript Array 包装对象可能按 1-based 访问。
            result = []
            for i in range(1, count + 1):
                result.append(children[i])
            return result

        except Exception as e:
            print("[get_children_safe failed]:", obj, e)
            return []


    def get_all_children(self, obj):
        if obj is None:
            return []

        result = []

        for child in self.get_children_safe(obj):
            result.append(child)
            result.extend(self.get_all_children(child))

        return result
