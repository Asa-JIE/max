    def sort_by_hierarchy(self):
        """按 Biped 层级顺序排序 pairs。Prop 类对象放到最后。"""
        if not self.pairs or self.root_obj_bip is None:
            return

        old_pairs = list(self.pairs)
        all_children = self.get_all_children(self.root_obj_bip)

        if not all_children:
            print("[sort_by_hierarchy] all_children is empty, keep old pairs")
            self.pairs = old_pairs
            return

        bip_list = [p.bip_obj for p in self.pairs]
        all_children = [c for c in all_children if c in bip_list]

        if not all_children:
            print("[sort_by_hierarchy] no mapped biped children found, keep old pairs")
            self.pairs = old_pairs
            return

        result = []
        props = []
        for child in all_children:
            idx = bip_list.index(child)
            btype = self.get_biped_type(child)
            if btype and str(btype.limb_name) in ("prop1", "prop2", "prop3"):
                props.append(self.pairs[idx])
            else:
                result.append(self.pairs[idx])
        result.extend(props)

        # 防止因为某些 Biped 子节点无法通过 children 枚举导致映射丢失。
        # 原 MaxScript 只追加 bipObj == undefined 的项；这里保留所有未进入 result 的 pair。
        for pair in old_pairs:
            if pair not in result:
                result.append(pair)

        self.pairs = result
