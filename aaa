    def set_file_stream(self):
        """把当前映射信息序列化成文本，类似原脚本的 .sftb 保存格式。"""
        lines = []
        foot_height = self.spin_foot_height.value() if self.spin_foot_height else 10
        lines.append("FootHeight = %s" % foot_height)
        for pair in self.pairs:
            lines.append("FbxObjHandle = %s" % (pair.fbx_obj.inode.handle if pair.fbx_obj else "undefined"))
            lines.append("FbxObjName = %s" % (pair.fbx_obj.name if pair.fbx_obj else ""))
            lines.append("BipObjHandle = %s" % (pair.bip_obj.inode.handle if pair.bip_obj else "undefined"))
            lines.append("BipObjName = %s" % (pair.bip_obj.name if pair.bip_obj else ""))
        return "\n".join(lines)

    def check_file_ext(self, path):
        """检查文件扩展名是否为 sftb。"""
        return os.path.splitext(path)[1].lower() == ".sftb"

    def save_mapping_as(self):
        """保存映射文件；保存前按 Biped 层级排序，对齐 MaxScript SaveAs。"""
        if not QtWidgets:
            return
        path, _ = QtWidgets.QFileDialog.getSaveFileName(self, "Save sftb file", "", "Sox Fbx to Biped (*.sftb);;All (*.*)")
        if not path:
            return
        if not path.lower().endswith(".sftb"):
            path += ".sftb"
        self.sort_by_hierarchy()
        self.set_list()
        try:
            with open(path, "w") as f:
                f.write(self.set_file_stream())
        except Exception:
            rt.messageBox("File Access Error")

    def _read_sftb_records(self, path):
        data = []
        record = {}
        with open(path, "r") as f:
            for raw in f:
                line = raw.strip()
                if not line or "=" not in line:
                    continue
                key, value = [x.strip() for x in line.split("=", 1)]
                if key == "FootHeight":
                    try:
                        if self.spin_foot_height:
                            self.spin_foot_height.setValue(float(value))
                    except Exception:
                        pass
                    continue
                record[key] = value
                if key == "BipObjName":
                    data.append(record)
                    record = {}
        return data

    def load_mapping(self):
        """加载映射文件。Name/Handle 两种模式保持 MaxScript 逻辑。"""
        if not QtWidgets:
            return
        if self.root_obj_fbx is None or self.root_obj_bip is None:
            rt.messageBox("You must Get root objects tempFirst")
            return
        path, _ = QtWidgets.QFileDialog.getOpenFileName(self, "Select sftb file", "", "SOX Fbx to Biped (*.sftb);;All (*.*)")
        if not path:
            return
        if not self.check_file_ext(path):
            rt.messageBox("*.sftb 犬厘磊父 瘤盔钦聪促")
            return
        records = self._read_sftb_records(path)
        self.pairs = []
        use_handle = self.radio_loading_handle.isChecked() if self.radio_loading_handle else True
        for rec in records:
            if use_handle:
                fbx = self._resolve_node_by_handle(rec.get("FbxObjHandle"), require_child_of=None)
                bip = self._resolve_node_by_handle(rec.get("BipObjHandle"), require_child_of=self.root_obj_bip)
            else:
                fbx = self._resolve_node_by_name(rec.get("FbxObjName"), require_child_of=None)
                bip = self._resolve_node_by_name(rec.get("BipObjName"), require_child_of=None)
            self.pairs.append(PairDef(fbx, bip))
        self.set_list()

    def _resolve_node_by_handle(self, handle_text, require_child_of=None):
        if not handle_text or handle_text == "undefined":
            return None
        try:
            node = rt.maxOps.getNodeByHandle(int(handle_text))
        except Exception:
            return None
        if node is None:
            return None
        if require_child_of is not None and not self.if_child(require_child_of, node):
            return None
        return node

    def _resolve_node_by_name(self, name_text, require_child_of=None):
        if not name_text:
            return None
        result = None
        for obj in self.get_objs_by_name(name_text.strip()):
            if require_child_of is None or self.if_child(require_child_of, obj):
                result = obj
        return result

    def _resolve_node(self, handle_text, name_text):
        """兼容旧调用。"""
        use_handle = self.radio_loading_handle.isChecked() if self.radio_loading_handle else True
        return self._resolve_node_by_handle(handle_text) if use_handle else self._resolve_node_by_name(name_text)

    # ============================================================
    # 动画 / Biped 关键功能
    # ============================================================

    def get_biped_foot_angle_quat(self, bip_foot):
        """计算 Biped 脚部相对 FBX 脚部的 Z 轴补偿旋转。"""
        foot_angle = 0.0
        try:
            foot_children = self.get_children_safe(bip_foot)
            bip_toe = foot_children[0] if foot_children else None
            if bip_toe is None:
                return rt.quat(0, 0, 0, 1)
        except Exception:
            return rt.quat(0, 0, 0, 1)

        foot_index = self.find_in_pairs_bip(bip_foot)
        toe_index = self.find_in_pairs_bip(bip_toe)
        if foot_index < 0 or toe_index < 0:
            return rt.quat(0, 0, 0, 1)

        fbx_foot = self.pairs[foot_index].fbx_obj
        fbx_toe = self.pairs[toe_index].fbx_obj
        if fbx_foot is None or fbx_toe is None:
            return rt.quat(0, 0, 0, 1)

        dist_c = rt.distance(fbx_foot.pos, fbx_toe.pos)
        dist_b = self.spin_foot_height.value() if self.spin_foot_height else 10
        if dist_c <= dist_b:
            return rt.quat(0, 0, 0, 1)
        dist_a = rt.sqrt(dist_c * dist_c - dist_b * dist_b)
        foot_angle = rt.atan(dist_b / dist_a)
        return rt.quat(-foot_angle, rt.Point3(0, 0, 1))

    def sync_key_ranged_all(self, frame_start, frame_end):
        """把所有 FBX 映射对象的 transform 烘焙到对应 Biped/普通对象上。"""
        if self.root_obj_fbx is None or self.root_obj_bip is None:
            rt.messageBox("请先设置 FBX Root 和 Biped Root")
            return
        if not self.check_match():
            rt.messageBox("请检查映射列表，有 FBX/Bip 没有成对设置")
            return

        # 关闭 Figure Mode，并开启四肢独立轨道
        if self.is_biped_object(self.root_obj_bip):
            try:
                self.root_obj_bip.controller.rootnode.controller.figureMode = False
                self.root_obj_bip.controller.sepLegsTracks = True
                self.root_obj_bip.controller.sepArmsTracks = True
            except Exception:
                pass

        rt.clearSelection()

        # 逐帧处理 Root
        for frame in range(int(frame_start), int(frame_end) + 1):
            with rt.animate(True):
                rt.sliderTime = frame
                if self.is_biped_object(self.root_obj_bip):
                    rt.biped.setTransform(self.root_obj_bip, rt.Name("pos"), self.root_obj_fbx.transform.position, True)
                    rt.biped.setTransform(self.root_obj_bip, rt.Name("rotation"), self.root_obj_fbx.transform.rotation, True)
                else:
                    m = rt.matrix3(1)
                    m.rotation = self.root_obj_fbx.transform.rotation
                    m.position = self.root_obj_fbx.transform.position
                    self.root_obj_bip.transform = m

        # 逐帧处理映射列表
        total = max(len(self.pairs), 1)
        for index, pair in enumerate(self.pairs):
            bip_obj = pair.bip_obj
            fbx_obj = pair.fbx_obj
            if bip_obj is None or fbx_obj is None:
                continue
            bip_type = self.get_biped_type(bip_obj)
            for frame in range(int(frame_start), int(frame_end) + 1):
                with rt.animate(True):
                    rt.sliderTime = frame
                    if self.is_biped_object(bip_obj):
                        quat = fbx_obj.transform.rotation
                        if bip_type and str(bip_type.limb_name) in ("lleg", "rleg") and bip_type.link_index == 3:
                            quat = self.get_biped_foot_angle_quat(bip_obj) * quat
                        rt.biped.setTransform(bip_obj, rt.Name("pos"), fbx_obj.transform.position, True)
                        rt.biped.setTransform(bip_obj, rt.Name("rotation"), quat, True)
                    else:
                        m = rt.matrix3(1)
                        m.rotation = fbx_obj.transform.rotation
                        m.position = fbx_obj.transform.position
                        bip_obj.transform = m
            if self.progress_bar:
                self.progress_bar.setValue(int((float(index + 1) / total) * 100))

    def sync_key_ranged_sel(self, frame_start, frame_end, obj):
        """只同步一个选中的 Biped/普通对象。"""
        if obj == self.root_obj_bip:
            # 选中 root 时，只同步 Root
            for frame in range(int(frame_start), int(frame_end) + 1):
                with rt.animate(True):
                    rt.sliderTime = frame
                    if self.is_biped_object(self.root_obj_bip):
                        rt.biped.setTransform(self.root_obj_bip, rt.Name("pos"), self.root_obj_fbx.transform.position, True)
                        rt.biped.setTransform(self.root_obj_bip, rt.Name("rotation"), self.root_obj_fbx.transform.rotation, True)
                    else:
                        self.root_obj_bip.transform = self.root_obj_fbx.transform
            return

        idx = self.find_in_pairs_bip(obj)
        if idx < 0:
            rt.messageBox("当前选择不在映射列表中")
            return
        pair = self.pairs[idx]
        for frame in range(int(frame_start), int(frame_end) + 1):
            with rt.animate(True):
                rt.sliderTime = frame
                if self.is_biped_object(pair.bip_obj):
                    rt.biped.setTransform(pair.bip_obj, rt.Name("pos"), pair.fbx_obj.transform.position, True)
                    rt.biped.setTransform(pair.bip_obj, rt.Name("rotation"), pair.fbx_obj.transform.rotation, True)
                else:
                    pair.bip_obj.transform = pair.fbx_obj.transform

    def reset_biped_matrix(self):
        """把列表中的 Biped transform 初始化为 Matrix3 1。"""
        for pair in self.pairs:
            if pair.bip_obj is not None:
                pair.bip_obj.transform = rt.matrix3(1)

