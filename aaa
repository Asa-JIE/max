    def get_node_by_userprop_handle(self, obj, prop_name):
        """从 userProp 中读取 handle，再转回 Max 节点。"""
        try:
            handle = rt.getUserProp(obj, prop_name)
            if handle is None:
                return None
            return rt.maxOps.getNodeByHandle(int(handle))
        except Exception:
            return None

    def get_parent_obj(self, obj):
        return self.get_node_by_userprop_handle(obj, "FBXtoBiped_FixedDistHelperParent")

    def get_target_obj(self, obj):
        return self.get_node_by_userprop_handle(obj, "FBXtoBiped_FixedDistHelperTarget")

    def get_helper_type(self, obj):
        try:
            return rt.getUserProp(obj, "FBXtoBiped_FixedDistHelperType")
        except Exception:
            return None

    def get_lookat_helper_by_pointer(self, obj):
        return self.get_node_by_userprop_handle(obj, "FBXtoBiped_FixedDistPointerLookAt")

    def get_orientation_helper_by_pointer(self, obj):
        return self.get_node_by_userprop_handle(obj, "FBXtoBiped_FixedDistPointerOrientation")

    def get_lookat_helper(self, sel_a, sel_b):
        """从 sel_a 的子物体里查找指向 sel_b 的 LookAt helper。"""
        for obj in self.get_children_safe(sel_a):
            if self.get_helper_type(obj) == "LookAt":
                if self.get_target_obj(obj) == sel_b:
                    return obj
        return None

    def find_orientation_helper_by_target(self, obj):
        """在所有 helper 中查找 target 为 obj 的 Orientation helper。"""
        for h in rt.helpers:
            if self.get_helper_type(h) == "Orientation" and self.get_target_obj(h) == obj:
                return h
        return None

