    def get_selection(self):
        """返回当前 Max 选择列表。"""
        return list(rt.selection)

    def get_selected_one(self):
        """如果只选择了一个物体，则返回该物体；否则返回 None。"""
        sel = self.get_selection()
        if len(sel) == 1:
            return sel[0]
        return None

    def is_biped_object(self, obj):
        """判断是否为 Biped_Object。"""
        if obj is None:
            return False
        try:
            return rt.classOf(obj) == rt.Biped_Object
        except Exception:
            return False

    def get_local_transform(self, tr_parent, tr_child):
        """获取 child 相对 parent 的局部矩阵。MaxScript: trChild * inverse trParent"""
        return tr_child * rt.inverse(tr_parent)

    def non_biped_check(self):
        """检查映射列表里是否包含非 Biped 对象。"""
        result = False
        if self.root_obj_bip is not None and not self.is_biped_object(self.root_obj_bip):
            result = True
        for pair in self.pairs:
            if pair.bip_obj is not None and not self.is_biped_object(pair.bip_obj):
                result = True
        return result

    def check_match(self):
        """检查 pairs 中 FBX/Bip 是否成对存在。"""
        for pair in self.pairs:
            if pair.fbx_obj is None and pair.bip_obj is not None:
                return False
            if pair.fbx_obj is not None and pair.bip_obj is None:
                return False
        return True

    def get_local_scale_x_world_pos(self, bip_obj):
        """根据 Biped 的 X 轴 scale 计算一个世界坐标点，用于判断哪个子节点更接近骨骼长度方向。"""
        t_scale = rt.biped.getTransform(bip_obj, rt.Name("scale"))
        t_matrix = rt.matrix3(1)
        t_matrix.pos = rt.Point3(t_scale.x, 0, 0)
        t_matrix = t_matrix * bip_obj.transform
        return t_matrix.pos

    def get_child_by_scale_pos(self, bip_obj):
        """当 Biped 有多个子节点时，找出最接近 scale X 方向终点的子节点。"""
        if not self.is_biped_object(bip_obj):
            return None

        children = self.get_children_safe(bip_obj)
        if len(children) == 1:
            return children[0]
        if len(children) == 0:
            return None

        dest_pos = self.get_local_scale_x_world_pos(bip_obj)
        best_child = None
        best_dist = None
        for child in children:
            d = rt.distance(child.transform.position, dest_pos)
            if best_dist is None or d < best_dist:
                best_dist = d
                best_child = child
        return best_child

    def get_biped_type(self, obj):
        """识别 Biped 节点属于哪类 limb，以及 link 编号。"""
        if obj is None:
            return None
        if not self.is_biped_object(obj):
            return BipType(limb_name=rt.Name("nonBiped"), link_index=0)

        loop_count = 30
        types = [
            "larm", "rarm", "lfingers", "rfingers", "lleg", "rleg", "ltoes", "rtoes",
            "spine", "tail", "head", "pelvis", "vertical", "horizontal", "turn",
            "footprints", "neck", "pony1", "pony2", "prop1", "prop2", "prop3",
            "lfArmTwist", "rfArmTwist", "lUparmTwist", "rUparmTwist",
            "lThighTwist", "rThighTwist", "lCalfTwist", "rCalfTwist",
            "lHorseTwist", "rHorseTwist",
        ]
        for typ in types:
            for link in range(1, loop_count + 1):
                try:
                    node = rt.biped.getNode(obj, rt.Name(typ), link=link)
                    if node == obj:
                        return BipType(limb_name=rt.Name(typ), link_index=link)
                except Exception:
                    pass
        # 没识别出来时，按 xtra 处理
        return BipType(limb_name=rt.Name("xtra"), link_index=0)

    def swap_array(self, arr, id1, id2):
        """交换数组中的两个元素，MaxScript 是 1 基索引；Python 这里使用 0 基索引。"""
        arr = list(arr)
        if id1 < 0 or id2 < 0 or id1 >= len(arr) or id2 >= len(arr):
            return arr
        arr[id1], arr[id2] = arr[id2], arr[id1]
        return arr

    def append_children(self, arr, children):
        """把 children 追加到数组。"""
        for child in children:
            arr.append(child)
