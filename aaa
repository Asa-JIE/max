class PairDef(object):
    """FBX 节点与 Biped 节点的一组映射。"""

    def __init__(self, fbx_obj=None, bip_obj=None):
        self.fbx_obj = fbx_obj
        self.bip_obj = bip_obj


class BipType(object):
    """Biped 类型信息，对应 MaxScript 中的 bipType struct。"""

    def __init__(self, limb_name=None, link_index=0):
        self.limb_name = limb_name
        self.link_index = link_index


