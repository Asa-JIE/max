    def callback_sync_sel(self):
        """模拟 MaxScript selectionSetChanged 回调：选中映射节点时同步列表选择。"""
        sel = self.get_selection()
        if not sel:
            return
        obj = sel[0]
        for i, pair in enumerate(self.pairs):
            if pair.fbx_obj == obj or pair.bip_obj == obj:
                if self.list_widget:
                    self.list_widget.setCurrentRow(i)
                self.set_bip_info()
                return

    def reset_data(self):
        """清空工具数据。"""
        self.pairs = []
        self.root_obj_fbx = None
        self.root_obj_bip = None
        self.set_list()

