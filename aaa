    if MaxPlus is None or QtWidgets is None:
        return None

    try:
        return MaxPlus.GetQMaxMainWindow()
    except Exception:
        return None


def show():

    global _window

    if QtWidgets is None:
        rt.messageBox("当前 3ds Max Python 环境没有 PySide2")
        return None

    try:
        if _window is not None:
            _window.close()
            _window.deleteLater()
    except Exception:
        pass

    _window = SoxFbxToBipedTool(parent=get_max_main_window())
    _window.show()

    return _window


