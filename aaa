    def find_in_pairs_fbx(self, obj):
        """查找 obj 在 pairs 的 FBX 列中的位置，返回 Python 索引；找不到返回 -1。"""
        for i, pair in enumerate(self.pairs):
            try:
                if pair.fbx_obj == obj:
                    return i
            except Exception:
                pass
        return -1

    def find_in_pairs_bip(self, obj):
        """查找 obj 在 pairs 的 Bip 列中的位置，返回 Python 索引；找不到返回 -1。"""
        for i, pair in enumerate(self.pairs):
            try:
                if pair.bip_obj == obj:
                    return i
            except Exception:
                pass
        return -1

    def if_child(self, parent, obj):
        """判断 obj 是否在 parent 的子层级下面。"""
        node = obj
        while node is not None:
            if node == parent:
                return True
            node = node.parent
        return False

    def get_objs_by_name(self, name):
        """根据完全名称查找场景物体。"""
        return [o for o in rt.objects if o.name == name]

    def set_user_prop_fbx_root(self, obj):
        """在场景物体上记录 FBX Root 标记。"""
        if obj is None:
            return
        for o in rt.objects:
            try:
                if rt.getUserProp(o, "SoxFbxToBiped_FbxRoot") is not None:
                    rt.setUserProp(o, "SoxFbxToBiped_FbxRoot", False)
            except Exception:
                pass
        rt.setUserProp(obj, "SoxFbxToBiped_FbxRoot", True)

    def set_user_prop_bip_root(self, obj):
        """在场景物体上记录 Biped Root 标记。"""
        if obj is None:
            return
        for o in rt.objects:
            try:
                if rt.getUserProp(o, "SoxFbxToBiped_BipRoot") is not None:
                    rt.setUserProp(o, "SoxFbxToBiped_BipRoot", False)
            except Exception:
                pass
        rt.setUserProp(obj, "SoxFbxToBiped_BipRoot", True)

