try(destroyDialog rolExportRigFBX)catch()

rollout rolExportRigFBX "Rig FBX Exporter - Max2020" width:520 height:420
(
    editText edtBip "Biped Root:" text:"Bip001" width:220
    editText edtGroup "Mesh Group:" text:"group" width:220

    radioButtons rdoAxis "Up Axis:" labels:#("Y-Up", "Z-Up") default:1 columns:2

    spinner spnStart "Start:" range:[-99999,99999,0] type:#integer width:160
    spinner spnEnd "End:" range:[-99999,99999,1] type:#integer width:160

    checkbox chkSave "导出前保存Max文件" checked:true
    checkbox chkOpen "导出后打开目录" checked:true

    label lblPreset "Preset: 自动生成并加载 RigExport_Default.fbxexportpreset" width:480

    button btnExport "Export Rig FBX" width:500 height:40

    listBox lbLog "Log" width:500 height:12

    fn logMsg msg =
    (
        lbLog.items = append lbLog.items msg
        lbLog.selection = lbLog.items.count
        format "%\n" msg
    )

    fn safeSetFBXParam p v =
    (
        try(FBXExporterSetParam p v; true)
        catch
        (
            try(FBXExporterSetParam p (v as string); true)
            catch
            (
                format "[Skip FBX Param] % = %\n" p v
                false
            )
        )
    )

    fn getPresetPath =
    (
        (getDir #userScripts) + "\\RigExport_Default.fbxexportpreset"
    )

    fn applyRigFBXSetting startFrame endFrame axisState =
    (
        safeSetFBXParam "Geometry" true
        safeSetFBXParam "Animation" true
        safeSetFBXParam "Cameras" false
        safeSetFBXParam "Lights" false
        safeSetFBXParam "EmbedTextures" false

        safeSetFBXParam "SmoothingGroups" true
        safeSetFBXParam "TangentsandBinormals" true
        safeSetFBXParam "Triangulate" false

        safeSetFBXParam "BakeAnimation" true
        safeSetFBXParam "BakeFrameStart" startFrame
        safeSetFBXParam "BakeFrameEnd" endFrame
        safeSetFBXParam "BakeFrameStep" 1

        safeSetFBXParam "Skin" true
        safeSetFBXParam "Shape" true

        if axisState == 1 then
            safeSetFBXParam "UpAxis" "Y"
        else
            safeSetFBXParam "UpAxis" "Z"

        safeSetFBXParam "ASCII" false
        safeSetFBXParam "FileVersion" "FBX201800"
    )

    fn createDefaultPreset =
    (
        local presetPath = getPresetPath()

        applyRigFBXSetting 0 1 1

        try
        (
            FBXExporterSetParam "SaveExportPresetFile" presetPath
            true
        )
        catch
        (
            false
        )
    )

    fn loadDefaultPreset =
    (
        local presetPath = getPresetPath()

        if not (doesFileExist presetPath) do
        (
            createDefaultPreset()
        )

        if doesFileExist presetPath then
        (
            try
            (
                FBXExporterSetParam "LoadExportPresetFile" presetPath
                true
            )
            catch
            (
                false
            )
        )
        else false
    )

    fn collectChildren n arr =
    (
        if n != undefined do
        (
            appendIfUnique arr n
            for c in n.children do collectChildren c arr
        )
        arr
    )

    fn buildExportNodes bipNode groupNode =
    (
        local arr = #()
        collectChildren bipNode arr
        collectChildren groupNode arr
        arr
    )

    fn getOutFile =
    (
        if maxFilePath == "" or maxFileName == "" then undefined
        else
        (
            local baseName = getFilenameFile maxFileName
            local exportDir = maxFilePath + "export\\"

            if not (doesFileExist exportDir) do makeDir exportDir

            exportDir + baseName + "_rig.fbx"
        )
    )

    on btnExport pressed do
    (
        lbLog.items = #()

        if maxFilePath == "" or maxFileName == "" then
        (
            messageBox "请先保存当前 Max 文件。" title:"Rig FBX Exporter"
            return false
        )

        local bipNode = getNodeByName edtBip.text
        local groupNode = getNodeByName edtGroup.text

        if bipNode == undefined then
        (
            messageBox ("找不到 Biped Root: " + edtBip.text) title:"Rig FBX Exporter"
            return false
        )

        if groupNode == undefined then
        (
            messageBox ("找不到 Mesh Group: " + edtGroup.text) title:"Rig FBX Exporter"
            return false
        )

        if chkSave.checked do
        (
            saveMaxFile (maxFilePath + maxFileName)
            logMsg "Scene saved."
        )

        local outFile = getOutFile()
        local exportDir = getFilenamePath outFile
        local presetPath = getPresetPath()

        loadDefaultPreset()

        -- 预设加载后，再用UI参数覆盖帧范围和轴向
        applyRigFBXSetting spnStart.value spnEnd.value rdoAxis.state

        local exportNodes = buildExportNodes bipNode groupNode
        select exportNodes

        logMsg ("Preset: " + presetPath)
        logMsg ("Biped Root: " + bipNode.name)
        logMsg ("Mesh Group: " + groupNode.name)
        logMsg ("Export node count: " + exportNodes.count as string)
        logMsg ("Output: " + outFile)

        exportFile outFile #noPrompt selectedOnly:true using:FBXEXP

        logMsg "Export done."

        if chkOpen.checked do shellLaunch exportDir ""
    )
)

createDialog rolExportRigFBX
